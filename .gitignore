# Unity default ignores với tiền tố thư mục dự án
RuinBeneathTheGiants/[Ll]ibrary/
RuinBeneathTheGiants/[Tt]emp/
RuinBeneathTheGiants/[Oo]bj/
RuinBeneathTheGiants/[Bb]uild/
RuinBeneathTheGiants/[Bb]uilds/
RuinBeneathTheGiants/[Ll]ogs/
RuinBeneathTheGiants/[Uu]ser[Ss]ettings/
RuinBeneathTheGiants/.utmp/

# Loại bỏ các file log và dữ liệu tạm
RuinBeneathTheGiants/*.log
RuinBeneathTheGiants/[Mm]emoryCaptures/
RuinBeneathTheGiants/[Rr]ecordings/

# Loại bỏ các file giải định/cấu hình IDE trong thư mục dự án
RuinBeneathTheGiants/*.csproj
RuinBeneathTheGiants/*.unityproj
RuinBeneathTheGiants/*.sln
RuinBeneathTheGiants/*.suo
RuinBeneathTheGiants/*.tmp
RuinBeneathTheGiants/*.user
RuinBeneathTheGiants/*.userprefs
RuinBeneathTheGiants/*.pidb
RuinBeneathTheGiants/*.booproj
RuinBeneathTheGiants/*.svd
RuinBeneathTheGiants/*.pdb
RuinBeneathTheGiants/*.mdb
RuinBeneathTheGiants/*.opendb
RuinBeneathTheGiants/*.VC.db
RuinBeneathTheGiants/.vs/

# Unity3D generated meta files (cho các file bị ignore)
RuinBeneathTheGiants/*.pidb.meta
RuinBeneathTheGiants/*.pdb.meta
RuinBeneathTheGiants/*.mdb.meta

# Crash reports & auto generated files
RuinBeneathTheGiants/sysinfo.txt
RuinBeneathTheGiants/mono_crash.*

# Builds
RuinBeneathTheGiants/*.apk
RuinBeneathTheGiants/*.aab
RuinBeneathTheGiants/*.unitypackage
RuinBeneathTheGiants/*.unitypackage.meta
RuinBeneathTheGiants/*.app

# Addressables & Visual Scripting
RuinBeneathTheGiants/[Aa]ssets/StreamingAssets/aa*
RuinBeneathTheGiants/[Aa]ssets/AddressableAssetsData/link.xml*
RuinBeneathTheGiants/[Aa]ssets/Addressables_Temp*
RuinBeneathTheGiants/[Aa]ssets/AddressableAssetsData/*/*.bin*
RuinBeneathTheGiants/[Aa]ssets/Unity.VisualScripting.Generated/

# JetBrains Rider
RuinBeneathTheGiants/[Aa]ssets/Plugins/Editor/JetBrains*
RuinBeneathTheGiants/*.DotSettings.user

.codegraph/
